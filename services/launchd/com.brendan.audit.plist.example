<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.brendan.audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd ~/brendan-os && claude -p "$(cat scripts/audit.md)" --allowedTools Read,Write,Glob,Grep</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>/Users/brendan/Library/Logs/brendan-os/audit.log</string>
  <key>StandardErrorPath</key><string>/Users/brendan/Library/Logs/brendan-os/audit.err</string>
</dict>
</plist>
